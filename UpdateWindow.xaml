<Window x:Class="DynamicIsland.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DynamicIsland"
        Title="Обновление" Width="1280" Height="800"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        UseLayoutRounding="True" WindowStartupLocation="Manual"
        FontFamily="{DynamicResource Face}" Foreground="White">

    <Window.Resources>
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF"/>
        <SolidColorBrush x:Key="Faint" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="Green" Color="#30D158"/>
        <SolidColorBrush x:Key="Red" Color="#FF453A"/>
        <SolidColorBrush x:Key="Plate" Color="#14FFFFFF"/>

        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Faint}"/>
        </Style>

        <Style x:Key="MetaRow" TargetType="Grid">
            <Setter Property="Height" Value="34"/>
        </Style>

        <Style x:Key="MetaKey" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate" Background="{TemplateBinding Background}" CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{StaticResource Plate}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="13">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#21FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="54"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Disc" Fill="White" Opacity="0"/>
                            <local:Icon Kind="Cross" Width="19" Height="19" Fill="{StaticResource Dim}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Opacity" Value="0.12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="#8C000000" MouseLeftButtonUp="Scrim_Click"/>

        <Border MaxWidth="900" MaxHeight="620" Margin="24,30" VerticalAlignment="Center"
                Background="#0C0C0E" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="30" Padding="34,24,34,26">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="70" ShadowDepth="20" Opacity="0.65"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="54" Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="10" Background="#26FF9F0A">
                            <local:Icon Kind="Update" Width="15" Height="15" Fill="{StaticResource Orange}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Style="{StaticResource Head}" Text="ОБНОВЛЕНИЕ" Margin="12,0,0,2"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="292"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,26,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <TextBlock x:Name="VersionText" Text="1.1.1" FontSize="58" FontWeight="SemiBold"
                                       FontFamily="{DynamicResource FaceDisplay}" LineHeight="58"
                                       LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="VersionNote" Text="" FontSize="14" Foreground="{StaticResource Dim}"
                                       Margin="14,0,0,12" VerticalAlignment="Bottom"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusText" Style="{StaticResource Head}" Margin="0,10,0,0" Text=""/>

                        <TextBlock Style="{StaticResource Head}" Text="ЧТО НОВОГО" Margin="0,22,0,0"/>
                        <ScrollViewer x:Name="NotesScroll" MaxHeight="230" Margin="0,9,0,0"
                                      VerticalScrollBarVisibility="Hidden" Focusable="False">
                            <ItemsControl x:Name="NotesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="4" Height="4" Fill="{StaticResource Orange}"
                                                     VerticalAlignment="Top" Margin="0,7,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="14" Foreground="#D8FFFFFF"
                                                       TextWrapping="Wrap" LineHeight="21"
                                                       LineStackingStrategy="BlockLineHeight"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="NotesEmpty" FontSize="14" Foreground="{StaticResource Dim}"
                                   Text="В этом релизе описания нет — всё оно на странице релиза." Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Border Background="#0DFFFFFF" CornerRadius="17" Padding="15,7">
                            <StackPanel>
                                <Grid Style="{StaticResource MetaRow}">
                                    <TextBlock Style="{StaticResource MetaKey}" Text="Установлена"/>
                                    <TextBlock x:Name="CurrentText" Style="{StaticResource MetaValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource MetaRow}">
                                    <TextBlock Style="{StaticResource MetaKey}" Text="Размер файла"/>
                                    <TextBlock x:Name="SizeText" Style="{StaticResource MetaValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource MetaRow}">
                                    <TextBlock Style="{StaticResource MetaKey}" Text="Вышла"/>
                                    <TextBlock x:Name="DateText" Style="{StaticResource MetaValue}"/>
                                </Grid>
                                <Grid Style="{StaticResource MetaRow}">
                                    <TextBlock Style="{StaticResource MetaKey}" Text="SHA-256"/>
                                    <TextBlock x:Name="HashText" Style="{StaticResource MetaValue}" FontFamily="Consolas, Segoe UI"
                                               FontSize="11.5" FontWeight="Normal" Foreground="{StaticResource Dim}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource LinkButton}" Margin="0,12,0,0" Click="OpenRelease_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Страница релиза" VerticalAlignment="Center"/>
                                <local:Icon Kind="Chevron" Width="11" Height="11" Fill="White" Margin="8,1,0,0"
                                            VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="Progress" Grid.Column="0" Height="52" VerticalAlignment="Top" Visibility="Collapsed">
                        <local:Ring x:Name="ProgressRing" Width="34" Height="34" Thickness="3.5" Progress="0"
                                    Stroke="{StaticResource Orange}" RenderTransformOrigin="0.5,0.5"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                            <local:Ring.RenderTransform>
                                <ScaleTransform ScaleX="-1"/>
                            </local:Ring.RenderTransform>
                        </local:Ring>
                        <StackPanel Margin="48,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressPercent" Text="0%" FontSize="14.5" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ProgressBytes" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="CheckButton" Style="{StaticResource ActionButton}" Width="176" Margin="0,0,10,0"
                                Background="{StaticResource Plate}" Click="Check_Click"/>
                        <Button x:Name="InstallButton" Style="{StaticResource ActionButton}" Width="286"
                                Background="{StaticResource Orange}" Foreground="Black" Click="Install_Click"/>
                        <Button x:Name="CloseFootButton" Style="{StaticResource ActionButton}" Width="120"
                                Background="{StaticResource Plate}" Content="Закрыть" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
